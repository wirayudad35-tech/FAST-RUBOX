  const [chatInput, setChatInput] = useState('');

  // Form error verification states
  const [formErrors, setFormErrors] = useState({});

  const chatEndRef = useRef(null);
  const terminalBottomRef = useRef(null);

  const getAvatarSvg = (name) => {
    const seed = name || 'Rubox';
    let hash = 0;
    for (let i = 0; i < seed.length; i++) {
      hash = seed.charCodeAt(i) + ((hash << 5) - hash);
    }
    const colorH = Math.abs(hash % 360);
    const bgGradient = `linear-gradient(135deg, hsl(${colorH}, 70%, 40%), hsl(${(colorH + 120) % 360}, 80%, 25%))`;
    
    return (
      <div className="w-14 h-14 rounded-full flex items-center justify-center font-bold text-white text-xl relative shadow-md shrink-0" style={{ background: bgGradient }}>
        {seed.substring(0, 2).toUpperCase()}
        <span className="absolute bottom-0 right-0 w-3.5 h-3.5 bg-green-500 border-2 border-zinc-900 rounded-full animate-pulse" />
      </div>
    );
  };

  useEffect(() => {
    const names = ['Andi_Gamer', 'RobloxPro90', 'Cindy_Blox', 'DevCreator', 'LegoBoy', 'SkaterKid', 'Windah_F', 'Zilong99'];
    const packages = ['1,000 RUBOX', '500 RUBOX', '3,000 RUBOX', '10,000 RUBOX', '100 RUBOX', '5,000 RUBOX'];
    
    const interval = setInterval(() => {
      const randomName = names[Math.floor(Math.random() * names.length)];
      const randomPackage = packages[Math.floor(Math.random() * packages.length)];
      setLiveToast({ name: randomName, package: randomPackage });
      
      setTimeout(() => {
        setLiveToast(null);
      }, 5000);
    }, 12000);

    return () => clearInterval(interval);
  }, []);

  useEffect(() => {
    let timer;
    if (invoiceModalOpen && invoiceStatus === 'PENDING' && paymentTimer > 0) {
      timer = setInterval(() => {
        setPaymentTimer(prev => prev - 1);
      }, 1000);
    }
    return () => clearInterval(timer);
  }, [invoiceModalOpen, invoiceStatus, paymentTimer]);

  useEffect(() => {
    if (botOpen && chatEndRef.current) {
      chatEndRef.current.scrollIntoView({ behavior: 'smooth' });
    }
  }, [botMessages, botOpen]);

  useEffect(() => {
    if (terminalBottomRef.current) {
      terminalBottomRef.current.scrollIntoView({ behavior: 'smooth' });
    }
  }, [botLogs]);

  const handleValidateUsername = (e) => {
    e.preventDefault();
    if (!username.trim()) return;
    
    setIsValidating(true);
    setIsValidated(false);
    
    setTimeout(() => {
      setIsValidating(false);
      setIsValidated(true);
    }, 1200);
  };

  const handleSelectRandomUsername = () => {
    const randomName = RANDOM_USERNAMES[Math.floor(Math.random() * RANDOM_USERNAMES.length)];
    setUsername(randomName);
    setIsValidated(true);
  };

  const handleCloseInvoiceModal = () => {
    if (invoiceStatus === 'PENDING' || invoiceStatus === 'COMPLETED') {
      setInvoiceModalOpen(false);
      setCloseWarningOpen(false);
      setBotLogs([]);
      setSandboxView('invoice');
    } else {
      setCloseWarningOpen(true);
    }
  };

  const forceCloseInvoiceModal = () => {
    setInvoiceModalOpen(false);
    setCloseWarningOpen(false);
    setBotLogs([]);
    setSandboxView('invoice');
  };

  const runDeliveryBotSimulation = (invoice) => {
    setIsBotProcessing(true);
    setInvoiceStatus('PROCESSING');
    
    const logs = [
      { t: 0, text: '🤖 [SYSTEM] Memulai daemon bot pengirim Rubox...' },
      { t: 1000, text: '🔌 [SYSTEM] Menghubungkan ke secure Roblox API Gateway...' },
      { t: 2500, text: `🔍 [SYSTEM] Memverifikasi status keanggotaan @${invoice.username} di Group Payout...` },
      { t: 4000, text: `✅ [DATABASE] Akun @${invoice.username} terverifikasi. ID User: RBX-${Math.floor(1000000 + Math.random() * 9000000)}` },
      { t: 5500, text: `📦 [SYSTEM] Mempersiapkan payload transfer sejumlah: ${invoice.amount}` },
      { t: 7000, text: '🤖 [BOT_04] Menyambung ke saldo utama group payout RuboxStore...' },
      { t: 8500, text: '💰 [BOT_04] Saldo group saat ini: 42,910 R$ (Cukup untuk pesanan)' },
      { t: 10000, text: `⚡ [BOT_04] Mengeksekusi API Group Payout ke target: @${invoice.username}...` },
      { t: 12000, text: `🎉 [SUCCESS] Berhasil mentransfer ${invoice.amount} ke @${invoice.username}!` },
      { t: 13500, text: `📱 [NOTIFIKASI] Mengirim pesan konfirmasi otomatis ke WA: ${invoice.whatsapp}...` },
      { t: 15000, text: '🏁 [SYSTEM] Transaksi selesai sempurna. Mengupdate status database ke SUKSES.' }
    ];

    logs.forEach((log) => {
      setTimeout(() => {
        setBotLogs(prev => [...prev, {
          time: new Date().toLocaleTimeString(),
          text: log.text
        }]);
        
        if (log.text.includes('[SUCCESS]')) {
          setInvoiceStatus('COMPLETED');
          setIsBotProcessing(false);
          // Insert into simulated system list
          const completedTx = {
            id: invoice.id,
            username: invoice.username,
            amount: invoice.amount,
            price: invoice.total,
            status: 'SUCCESS',
            date: 'Barusan',
            payment: invoice.payment
          };
          setSimulatedTransactions(prev => [completedTx, ...prev]);
        }
      }, log.t);
    });
  };

  const handleSimulatedPaymentSubmit = () => {
    if (sandboxBalance < activeInvoice.total) {
      // Auto-charge balance for the simulator to proceed
      setSandboxBalance(prev => prev + 200000);
    }
    
    // Simulate transaction on phone screen
    setSandboxView('processing_payment');
    
    setTimeout(() => {
      setSandboxBalance(prev => prev - activeInvoice.total);
      setInvoiceStatus('PAID');
      setSandboxView('success_receipt');
      
      // Instantly transition to delivery pipeline
      setTimeout(() => {
        setSandboxView('bot_delivery');
        runDeliveryBotSimulation(activeInvoice);
      }, 2500);
    }, 2000);
  };

  const handleCheckout = () => {
    const errors = {};
    if (!username.trim()) errors.username = "Username Roblox wajib diisi!";
    if (!isValidated) errors.username = "Silakan verifikasi username Anda terlebih dahulu!";
    if (!selectedProduct) errors.product = "Pilih paket RUBOX yang Anda inginkan!";
    if (!selectedPayment) errors.payment = "Pilih salah satu metode pembayaran!";
    if (!whatsapp.trim()) {
      errors.whatsapp = "Nomor WhatsApp wajib diisi untuk notifikasi pengiriman!";
    } else if (!/^[0-9+]{8,15}$/.test(whatsapp)) {
      errors.whatsapp = "Nomor WhatsApp tidak valid!";
    }

    if (Object.keys(errors).length > 0) {
      setFormErrors(errors);
      if (errors.username) {
        scrollToSection('username-input-section');
      } else if (errors.product) {
        scrollToSection('catalog-section');
      } else if (errors.payment) {
        scrollToSection('payment-section');
      }
      return;
    }

    setFormErrors({});
    
    const newInvoiceId = `RBX-${Math.floor(10000 + Math.random() * 90000)}`;
    const totalAmount = selectedProduct.price + selectedPayment.fee;
    
    const invoice = {
      id: newInvoiceId,
      username: username,
      amount: selectedProduct.amount,
      price: selectedProduct.price,
      fee: selectedPayment.fee,
      total: totalAmount,
      payment: selectedPayment.name,
      paymentId: selectedPayment.id,
      accountNo: selectedPayment.accountNo,
      accountName: selectedPayment.accountName,
      whatsapp: whatsapp,
      date: 'Barusan',
      methodType: activeTab === 'gamepass' ? 'Gamepass Method' : 'Username Direct'
    };

    setActiveInvoice(invoice);
    setPaymentTimer(900); 
    setInvoiceStatus('PENDING');
    setBotLogs([]);
    setSandboxView('invoice');
    setInvoiceModalOpen(true);
  };

  return (
    <div className="min-h-screen bg-zinc-950 text-white font-sans overflow-x-hidden selection:bg-green-500 selection:text-black">
      {/* Background Decorative Mesh Glows */}
      <div className="absolute top-0 left-1/4 w-[500px] h-[500px] bg-green-500/10 rounded-full filter blur-[100px] pointer-events-none" />
      <div className="absolute top-[800px] right-1/4 w-[400px] h-[400px] bg-emerald-500/10 rounded-full filter blur-[100px] pointer-events-none" />
      <div className="absolute bottom-10 left-10 w-[600px] h-[600px] bg-green-600/5 rounded-full filter blur-[150px] pointer-events-none" />

      {/* Navbar */}
