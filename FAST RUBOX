          <div className="flex justify-between items-center h-16">
            <div className="flex items-center gap-2 cursor-pointer" onClick={() => window.scrollTo({top: 0, behavior: 'smooth'})}>
              <div className="p-2.5 bg-green-500 rounded-xl shadow-lg shadow-green-500/30 flex items-center justify-center">
                <ShoppingBag className="w-6 h-6 text-black" />
              </div>
              <span className="font-black text-2xl tracking-tight">
                RUBOX<span className="text-green-400">STORE</span>
              </span>
            </div>
            
            <div className="hidden md:flex items-center gap-8 text-sm font-semibold text-zinc-300">
              <button onClick={() => scrollToSection('home-hero')} className="hover:text-green-400 transition">Beranda</button>
              <button onClick={() => scrollToSection('order-form-container')} className="hover:text-green-400 transition">Top Up Sekarang</button>
              <button onClick={() => scrollToSection('order-tracker')} className="hover:text-green-400 transition">Cek Transaksi</button>
              <button onClick={() => scrollToSection('faq-section')} className="hover:text-green-400 transition">FAQ</button>
            </div>

            <div className="flex items-center gap-3">
              <span className="hidden lg:inline-flex items-center gap-1 text-xs font-semibold px-3 py-1 bg-green-500/15 text-green-400 border border-green-500/30 rounded-full">
                <span className="w-2 h-2 bg-green-400 rounded-full animate-ping" />
                Sistem Online 24/7
              </span>
              <button 
                onClick={() => scrollToSection('order-form-container')}
                className="px-5 py-2.5 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-400 hover:to-emerald-500 text-black font-extrabold text-sm rounded-xl transition shadow-lg shadow-green-500/20 transform active:scale-95"
              >
                MULAI BELI
              </button>
            </div>
          </div>
        </div>
      </nav>

      {/* Hero Section */}
      <header id="home-hero" className="relative z-10 text-center pt-16 pb-12 px-4 sm:px-6 max-w-7xl mx-auto">
        <div className="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-green-500/10 border border-green-400/30 text-green-400 text-sm font-bold mb-6 shadow-lg shadow-green-500/5 animate-bounce">
          <Zap className="w-4 h-4 fill-green-400" />
          SIMULATOR TOP UP INTERAKTIF & MODERN
        </div>

        <h1 className="text-4xl sm:text-6xl md:text-8xl font-black tracking-tight mb-6 leading-none">
          TOP UP <span className="bg-gradient-to-r from-green-400 to-emerald-300 bg-clip-text text-transparent drop-shadow-sm">RUBOX</span>
        </h1>

        <p className="text-zinc-400 max-w-2xl mx-auto text-base sm:text-xl leading-relaxed">
