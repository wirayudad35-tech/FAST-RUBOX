    { id: 'RBX-73918', username: 'Lollipop_Kid', amount: '500 RUBOX', price: 58800, status: 'SUCCESS', date: '5 menit lalu', payment: 'DANA' },
    { id: 'RBX-90182', username: 'Creeper_Steve', amount: '10,000 RUBOX', price: 786500, status: 'PROCESSING', date: '12 menit lalu', payment: 'BCA VA' }
