        </p>

        <div className="mt-10 flex flex-col sm:flex-row justify-center items-center gap-4">
          <button 
            onClick={() => scrollToSection('order-form-container')}
            className="w-full sm:w-auto px-8 py-4 bg-green-500 hover:bg-green-400 text-black transition-all rounded-2xl font-black text-lg shadow-xl shadow-green-500/30 transform hover:-translate-y-0.5 active:translate-y-0"
          >
            Mulai Pengujian 🔥
          </button>
          <button 
            onClick={() => scrollToSection('catalog-section')}
            className="w-full sm:w-auto px-8 py-4 border border-zinc-700 hover:border-green-400 hover:text-green-300 bg-zinc-900/40 transition-all rounded-2xl font-bold text-lg backdrop-blur-sm"
          >
            Daftar Paket Rubox
          </button>
        </div>

        {/* Dynamic feature badges */}
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 max-w-4xl mx-auto text-left">
          {[
            { icon: ShieldCheck, title: "100% Aman & Legal", desc: "Sesuai TOS Roblox" },
            { icon: Clock, title: "Proses Otomatis", desc: "Hanya 5-10 menit saja" },
            { icon: Wallet, title: "Pembayaran Lengkap", desc: "QRIS, E-Wallet, VA Bank" },
            { icon: Sparkles, title: "Bantuan CS 24/7", desc: "Panduan asisten interaktif" }
          ].map((feat, i) => (
            <div key={i} className="bg-zinc-900/40 border border-zinc-800 p-4 rounded-2xl flex items-start gap-3 backdrop-blur-sm">
              <div className="p-2 bg-green-500/10 rounded-xl text-green-400 mt-1">
                <feat.icon className="w-5 h-5" />
              </div>
              <div>
                <h4 className="font-bold text-sm text-white">{feat.title}</h4>
                <p className="text-xs text-zinc-400">{feat.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </header>

      {/* Main Container */}
