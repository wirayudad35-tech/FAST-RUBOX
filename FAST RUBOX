  // Advanced simulation states
  const [sandboxView, setSandboxView] = useState('invoice'); // invoice, phone_wallet, bank_transfer
  const [sandboxBalance, setSandboxBalance] = useState(250000); // User's mock e-wallet balance
  const [botLogs, setBotLogs] = useState([]); // Real-time delivery bot simulation logs
